# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co

# Public app URL — used for shareable booking links, emails, and webhooks.
# Set both in every environment (local, staging, production).
# Runtime APP_URL must match vault secret `app_url` used by billing pg_cron
# (see migration 20260820130000_billing_crons_app_url.sql).
#
# Local dev example:
#   VITE_APP_URL=http://localhost:8080
#   APP_URL=http://localhost:8080
#
# Production example:
#   VITE_APP_URL=https://www.flowybookings.com
#   APP_URL=https://www.flowybookings.com
#
# Platform Mollie webhooks: Mollie cannot reach localhost / private / http origins.
# If APP_URL (or PUBLIC_APP_URL / SITE_URL) is not public https, checkout omits
# webhookUrl. Test payments still work; status is applied on return via confirm/
# reconcile. For live local webhooks, point APP_URL at an ngrok https URL that
# forwards to this app's /api/mollie/webhook.
VITE_APP_URL=https://785d-2407-d000-17-4278-c70-7548-c1bb-4048.ngrok-free.app
APP_URL=https://785d-2407-d000-17-4278-c70-7548-c1bb-4048.ngrok-free.app
CRON_SECRET=


# Server-only. Used by notification emails (PGMQ enqueue + Edge Function drain).
# NEVER prefix these with VITE_ — Vite ships VITE_* to the browser.
# Auth confirmation / forgot-password stay on Supabase Auth SMTP.
#
# Queue worker: Edge Function `process-email-queue`.
# Cron builds the URL from vault secret `supabase_url` +
# `/functions/v1/process-email-queue` (reuse `supabase_url` for future functions).
# Set RESEND_API_KEY as a Supabase Edge Function secret:
#   npx supabase secrets set RESEND_API_KEY=re_... --project-ref YOUR_REF
# App drain uses VITE_SUPABASE_URL/SUPABASE_URL + service role from .env.
RESEND_API_KEY=
EMAIL_FROM=FlowyBookings <notify@flowybookings.com>
SUPABASE_SERVICE_ROLE_KEY=

# Platform Mollie (FlowyBookings SaaS subscriptions — NOT Connect shop payouts).
# Create both keys in https://my.mollie.com → Developers → API keys.
#   Test key starts with test_
#   Live key starts with live_
#
# Local: set MOLLIE_MODE=test and paste the test key.
# Production (Render): set MOLLIE_MODE=live and the live key as env vars in the
# Render dashboard. Never prefix these with VITE_.
MOLLIE_MODE=test
MOLLIE_API_KEY_TEST=
MOLLIE_API_KEY_LIVE=
# Optional fallback if a mode-specific key is unset:
# MOLLIE_API_KEY=
# Optional rotation fallback for old customers/subscriptions:
# MOLLIE_API_KEY_LEGACY=

# Mollie Connect (per-shop OAuth — lets a shop accept booking deposits into
# THEIR OWN Mollie account, NOT FlowyBookings' platform account above).
# Create a separate OAuth "app" per environment at my.mollie.com → More →
# Developers → Your apps → Create Application. Each app has its own Client ID
# / Client Secret and exactly ONE redirect URL field (Mollie does not support
# a list), so don't reuse one app across dev and prod — you'd have to keep
# re-pointing its redirect URL, which risks breaking live merchant connects.
#   - Dev app redirect URL:  <your ngrok https tunnel>/api/mollie-connect/callback
#   - Prod app redirect URL: https://www.flowybookings.com/api/mollie-connect/callback
# Scopes to request (sent by the app at authorize time, not configured on the
# Mollie app itself): organizations.read profiles.read payments.read
# payments.write refunds.read refunds.write onboarding.read
#
# NOT the same as MOLLIE_CLIENT_ID / MOLLIE_CLIENT_SECRET / MOLLIE_WEBHOOK_SECRET
# above (those are unrelated fields on the platform-billing admin status card).
MOLLIE_CONNECT_CLIENT_ID=
MOLLIE_CONNECT_CLIENT_SECRET=
