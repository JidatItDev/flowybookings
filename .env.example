# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co

# Public app URL — used for shareable booking links, emails, and webhooks.
# Set both in every environment (local, staging, production).
#
# Local dev example:
#   VITE_APP_URL=http://localhost:8080
#   APP_URL=http://localhost:8080
#
# Production example:
#   VITE_APP_URL=https://www.flowybookings.com
#   APP_URL=https://www.flowybookings.com
#
# Platform Mollie webhooks: Mollie cannot reach localhost / private / http origins.
# If APP_URL (or PUBLIC_APP_URL / SITE_URL) is not public https, checkout omits
# webhookUrl. Test payments still work; status is applied on return via confirm/
# reconcile. For live local webhooks, point APP_URL at a Cloudflare tunnel or
# ngrok https URL that forwards to this app's /api/mollie/webhook.
VITE_APP_URL=http://localhost:8080
APP_URL=https://827a-2400-adcc-1112-1100-88be-25b4-625e-c290.ngrok-free.app

# Server-only. Used by notification emails (PGMQ worker + sendEmail).
# NEVER prefix these with VITE_ — Vite ships VITE_* to the browser.
# Auth confirmation / forgot-password stay on Supabase Auth SMTP.
#
# Local Cloudflare / wrangler also reads `.dev.vars` (gitignored). You can copy
# these same keys there.
RESEND_API_KEY=
EMAIL_FROM=FlowyBookings <notify@flowybookings.com>
SUPABASE_SERVICE_ROLE_KEY=

# Platform Mollie (FlowyBookings SaaS subscriptions — NOT Connect shop payouts).
# Create both keys in https://my.mollie.com → Developers → API keys.
#   Test key starts with test_
#   Live key starts with live_
#
# Local / wrangler: set MOLLIE_MODE=test and paste the test key.
# Production: set MOLLIE_MODE=live (Cloudflare secret or vars) and the live key.
# Never put live_ keys in .dev.vars. Never prefix these with VITE_.
MOLLIE_MODE=test
MOLLIE_API_KEY_TEST=
MOLLIE_API_KEY_LIVE=
# Optional fallback if a mode-specific key is unset:
# MOLLIE_API_KEY=
# Optional rotation fallback for old customers/subscriptions:
# MOLLIE_API_KEY_LEGACY=
